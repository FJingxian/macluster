<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.macluster.controller</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE/.local/bin/macluster</string>
    <string>--config</string>
    <string>/Users/REPLACE/.config/macluster/config.toml</string>
    <string>--state-dir</string>
    <string>/Users/REPLACE/Library/Application Support/macluster/controller</string>
    <string>controller</string>
    <string>run</string>
    <string>--interval</string>
    <string>2</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE/Library/Logs/macluster/controller.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/Library/Logs/macluster/controller.err.log</string>
</dict>
</plist>
